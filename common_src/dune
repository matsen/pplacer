; The version comes from, in order: $PPLACER_VERSION; git_archival.txt, which
; `git archive` (and so a GitHub tag tarball) fills in via export-subst; `git
; describe` in a checkout; and otherwise "dev".

(rule
 (targets version.ml)
 (deps
  (universe)
  (:archival git_archival.txt))
 (action
  (system
   "\| v="${PPLACER_VERSION:-}"
   "\| if [ -z "$v" ]; then
   "\|   v=$(tr -d '\n' < %{archival})
   "\|   case "$v" in *Format:*) v= ;; esac
   "\| fi
   "\| if [ -z "$v" ]; then
   "\|   v=$(git -C %{workspace_root} describe --tags --always --dirty 2>/dev/null)
   "\| fi
   "\| if [ -z "$v" ]; then v=dev; fi
   "\| printf 'let version = "%s"\n' "$v" > version.ml
   )))
